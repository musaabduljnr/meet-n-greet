# ==============================================================================
# KOUNTRY WAYNE VIP PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public & Service Role Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Admin Session HMAC Signing Secret (Generate with: openssl rand -hex 32)
ADMIN_SESSION_SECRET=kountry_wayne_vip_secure_hmac_session_secret_2026_change_in_production

# Development Admin Credentials Bypass (Set to "false" in production)
ENABLE_DEV_ADMINS=false
NEXT_PUBLIC_ENABLE_DEV_ADMINS=false

# Email Delivery Configuration (Provider options: "console", "resend")
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS="Kountry Wayne VIP <vip@kountrywayne.com>"
